    {
      "name": "🔔 Suscripción / Pagopar (staging)",
      "description": "Flujo completo de pago con Pagopar en entorno staging.\n\n**Orden de ejecución:**\n1. Login (guarda {{token}})\n2. GET Planes disponibles\n3. POST Iniciar Pago → guarda {{hashPedido}} automáticamente\n4. POST Simular Webhook Pago → calcula token SHA1 automáticamente y activa la suscripción\n5. GET Suscripción actual → verificar que está activa\n6. GET Historial de pagos\n\n**Claves staging:** PUBLIC=7fde2c9a716450803053bb4a1c0d4971 | PRIVATE=9321226ee984b4a5dda826d4c8ed555f",
      "item": [
        {
          "name": "1 · GET Planes disponibles",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/suscripcion/planes",
              "host": ["{{baseUrl}}"],
              "path": ["suscripcion","planes"]
            }
          },
          "response": []
        },
        {
          "name": "2 · GET Suscripción actual",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/suscripcion/actual",
              "host": ["{{baseUrl}}"],
              "path": ["suscripcion","actual"]
            }
          },
          "response": []
        },
        {
          "name": "3 · POST Iniciar Pago (crea pedido en Pagopar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('hashPedido', json.hashPedido);",
                  "    pm.collectionVariables.set('numeroPedido', json.numeroPedido);",
                  "    console.log('✅ Hash pedido guardado:', json.hashPedido);",
                  "    console.log('📋 Número pedido:', json.numeroPedido);",
                  "    console.log('🔗 URL checkout Pagopar:', json.checkoutUrl);",
                  "    pm.test('Pedido creado correctamente en Pagopar', () => {",
                  "        pm.expect(json.hashPedido).to.be.a('string').and.not.empty;",
                  "    });",
                  "} else {",
                  "    console.error('❌ Error al iniciar pago:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type","value": "application/json"},
              {"key": "Authorization","value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPlan\": 2,\n  \"nombreComprador\": \"Willian Cristaldo\",\n  \"emailComprador\": \"scristaldopy@gmail.com\",\n  \"documentoComprador\": \"5812345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/suscripcion/iniciar-pago",
              "host": ["{{baseUrl}}"],
              "path": ["suscripcion","iniciar-pago"]
            }
          },
          "response": []
        },
        {
          "name": "4 · POST Simular Webhook — Pago APROBADO ✅",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Calcula el token SHA1 que Pagopar enviaría: sha1(privateKey + hashPedido)",
                  "const privateKey = pm.collectionVariables.get('pagoparPrivateKey');",
                  "const hashPedido = pm.collectionVariables.get('hashPedido');",
                  "",
                  "if (!hashPedido) {",
                  "    console.error('❌ hashPedido vacío. Ejecutá primero el request 3 · Iniciar Pago.');",
                  "    return;",
                  "}",
                  "",
                  "const token = CryptoJS.SHA1(privateKey + hashPedido).toString();",
                  "pm.collectionVariables.set('webhookToken', token);",
                  "console.log('🔑 hashPedido:', hashPedido);",
                  "console.log('🔐 token webhook calculado:', token);",
                  "",
                  "// Armar el body dinámicamente con los valores calculados",
                  "const body = {",
                  "    resultado: [{",
                  "        pagado: true,",
                  "        cancelado: false,",
                  "        hash_pedido: hashPedido,",
                  "        token: token,",
                  "        numero_pedido: pm.collectionVariables.get('numeroPedido') || '9999',",
                  "        numero_comprobante_interno: '8888888',",
                  "        ultimo_mensaje_error: null,",
                  "        forma_pago: 'Tarjetas de crédito/débito',",
                  "        forma_pago_identificador: '9',",
                  "        fecha_pago: new Date().toISOString().replace('T', ' ').substring(0, 19),",
                  "        monto: '150000.00',",
                  "        fecha_maxima_pago: new Date(Date.now() + 86400000).toISOString().replace('T', ' ').substring(0, 19)",
                  "    }],",
                  "    respuesta: true",
                  "};",
                  "pm.collectionVariables.set('webhookBody', JSON.stringify(body));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook procesado con HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "console.log('✅ Respuesta webhook:', pm.response.text());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}/suscripcion/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["suscripcion","webhook"]
            }
          },
          "response": []
        },
        {
          "name": "4b · POST Simular Webhook — Pago REVERTIDO ❌",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const privateKey = pm.collectionVariables.get('pagoparPrivateKey');",
                  "const hashPedido = pm.collectionVariables.get('hashPedido');",
                  "",
                  "if (!hashPedido) {",
                  "    console.error('❌ hashPedido vacío. Ejecutá primero el request 3 · Iniciar Pago.');",
                  "    return;",
                  "}",
                  "",
                  "const token = CryptoJS.SHA1(privateKey + hashPedido).toString();",
                  "pm.collectionVariables.set('webhookToken', token);",
                  "",
                  "const body = {",
                  "    resultado: [{",
                  "        pagado: false,",
                  "        cancelado: false,",
                  "        hash_pedido: hashPedido,",
                  "        token: token,",
                  "        numero_pedido: pm.collectionVariables.get('numeroPedido') || '9999',",
                  "        numero_comprobante_interno: '8888888',",
                  "        ultimo_mensaje_error: 'Pago revertido por el comercio',",
                  "        forma_pago: 'Tarjetas de crédito/débito',",
                  "        forma_pago_identificador: '9',",
                  "        fecha_pago: null,",
                  "        monto: '150000.00',",
                  "        fecha_maxima_pago: new Date(Date.now() + 86400000).toISOString().replace('T', ' ').substring(0, 19)",
                  "    }],",
                  "    respuesta: true",
                  "};",
                  "pm.collectionVariables.set('webhookBody', JSON.stringify(body));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook reversión procesada con HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "console.log('↩️ Reversión procesada:', pm.response.text());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type","value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}/suscripcion/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["suscripcion","webhook"]
            }
          },
          "response": []
        },
        {
          "name": "5 · GET Suscripción actual (verificar activación)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.activa) {",
                  "        console.log('✅ Suscripción ACTIVA — Plan:', json.plan?.nombre);",
                  "        console.log('📅 Vence:', json.fechaVencimiento);",
                  "    } else {",
                  "        console.log('⚠️ Sin suscripción activa:', json.mensaje);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization","value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/suscripcion/actual",
              "host": ["{{baseUrl}}"],
              "path": ["suscripcion","actual"]
            }
          },
          "response": []
        },
        {
