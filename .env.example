# Copiar a .env y completar antes de `docker compose up`.
# .env NO debe commitearse (ya está en .gitignore).

POSTGRES_DB=DecisionSupport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# 32+ caracteres, distinta en cada entorno.
JWT_KEY=CHANGE_ME_SECRET_KEY_32_CHARS_MIN

# Opcional: notificaciones por email (alertas "No Apto", recibos de pago).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Opcional: pasarelas de pago del módulo de suscripción.
ADAMSPAY_API_KEY=
ADAMSPAY_API_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

ASPNETCORE_ENVIRONMENT=Production

# Opcional: puertos publicados en el servidor (por defecto 80 y 443; la API solo en 127.0.0.1:5000).
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=5000

# Opcional: nombre del servidor para el certificado autofirmado que se genera si ./certs está vacío.
# En producción, copiar en ./certs el certificado institucional como tls.crt y tls.key.
TLS_CN=localhost
